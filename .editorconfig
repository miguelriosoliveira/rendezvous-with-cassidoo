# COPY-ONLY template from https://github.com/miguelriosoliveira/shared-configs
# Copy this file to the repo root as .editorconfig. Do not extend or import it.

root = true

[*]
end_of_line = lf
indent_style = tab
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.yml, *.yaml]
indent_style = space

[*.txt]
insert_final_newline = false
